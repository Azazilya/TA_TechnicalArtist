            "m_Id": "60f00000000000000000000000000005"
        },
        {
            "m_Id": "60f00000000000000000000000000006"
        },
        {
            "m_Id": "60f00000000000000000000000000007"
        },
        {
            "m_Id": "60f00000000000000000000000000008"
        },
        {
            "m_Id": "60f00000000000000000000000000009"
        },
        {
            "m_Id": "60f0000000000000000000000000000a"
        },
        {
            "m_Id": "60f0000000000000000000000000000b"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SlashVFX",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float safeSize = max(Size, 0.01);\nfloat safeThickness = max(Thickness, 0.01);\nfloat2 centered = UV - 0.5;\ncentered.x /= safeSize;\ncentered.y /= (safeSize * safeThickness);\nfloat2 suv = centered + 0.5;\nfloat inside = step(0.0, suv.x) * step(suv.x, 1.0) * step(0.0, suv.y) * step(suv.y, 1.0);\nfloat age = saturate(ParticleColor.r);\nfloat swingProgress = saturate(age * max(_SwingSpeed, 0.001));\nfloat appearAlpha = smoothstep(0.0, 1.0, saturate(age * max(AppearSpeed, 0.001)));\nfloat swingBend = sin(saturate(suv.x) * 3.14159265) * (1.0 - swingProgress) * 0.035;\nsuv.y += swingBend;\nfloat4 tex = SAMPLE_TEXTURE2D(Texture.tex, Texture.samplerstate, suv);\nfloat revealSoftness = 0.06;\nfloat reveal = 1.0 - smoothstep(swingProgress, swingProgress + revealSoftness, suv.x);\nfloat endFade = 1.0 - smoothstep(0.8, 1.0, age);\nfloat verticalCore = 1.0 - saturate(abs(suv.y - 0.5) * 2.0);\nfloat coreMask = smoothstep(0.38, 0.82, verticalCore);\nfloat luminance = dot(tex.rgb, float3(0.2126, 0.7152, 0.0722));\nfloat textureDetail = lerp(0.7, 1.25, saturate(luminance));\nfloat3 coreColor = lerp(OuterCore.rgb, InnerCore.rgb, coreMask);\nOutColor = coreColor * textureDetail;\nOutAlpha = tex.a * inside * reveal * appearAlpha * endFade * ParticleColor.a * lerp(OuterCore.a, InnerCore.a, coreMask);"
}

