{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "20b00000000000000000000000000001",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SlashVFX (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -380.0,
            "y": 100.0,
